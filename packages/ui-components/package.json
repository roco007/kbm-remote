{
  "name": "@kbm-remote/ui-components",
  "version": "0.1.0",
  "private": true,
  "description": "Shared design system (tokens, theme, primitives) for the receiver's Electron UI and the sender's React Native UI",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "lint": "eslint src tests --ext .ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist .turbo"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "typescript": "^5.8.3",
    "vitest": "^3.2.1"
  }
}
